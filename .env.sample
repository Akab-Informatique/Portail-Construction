# Copy to .env on the server:
#   cp .env.sample .env
# Then set POSTGRES_PASSWORD and SESSION_SECRET. Keep the same password in DATABASE_URL.

# Public port on the host (container listens on 3000)
PORT=8080

# Git branch used by scripts/update.sh
GIT_BRANCH=main

# Local Docker Postgres (service name is `db`)
POSTGRES_DB=frx
POSTGRES_USER=frx
POSTGRES_PASSWORD=
DATABASE_URL=postgres://frx:CHANGE_ME@db:5432/frx

# Signed session cookies (required in production)
SESSION_SECRET=

# Leave 0 behind HTTPS (portail.frx.construction). Set 1 only to test over plain http://<ip>:8080
COOKIE_INSECURE=0

# Optional. Can also be set later in Setup → SharePoint
SHAREPOINT_CLIENT_SECRET=

# Optional SMTP (used by /api/mail/send instead of browser-supplied passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
